{
  "_comment": "Hybrid demonstration: character + set + narration + label + chart + callout + UI + camera change + transition + subtitles + sound in ONE composition. Every overlay is declared here; the renderer validates and draws it.",
  "id": "sistema_demo",
  "title": "El silencio heredado",
  "logline": "Un guardián que ya no toca la campana y un aprendiz que cuenta lo que falta.",
  "fps": 30,
  "style": "cinematic",
  "transitionFrames": 10,
  "library": [
    "rig:default",
    "character:elder",
    "character:young",
    "set:townnight",
    "set:doorway",
    "set:fielddawn",
    "camera:dollyin",
    "camera:pushinslow",
    "camera:panleft",
    "camera:dollyout",
    "transition:cut",
    "transition:dissolve"
  ],
  "shots": [
    {
      "id": "S01",
      "scene": "townNight",
      "camera": "dollyIn",
      "seconds": 5.2,
      "transitionIn": 0,
      "line": "Nadie supo cuándo dejó de sonar la campana.",
      "note": "establishing: the keeper stands under the bell post",
      "actors": [
        {
          "id": "elder",
          "preset": "idle",
          "x": 540,
          "y": 1600,
          "scale": 1.65,
          "facing": 1,
          "hold": "lantern",
          "armR": -34,
          "phase": 0.3
        }
      ],
      "overlays": [
        {
          "id": "L1",
          "type": "label",
          "placement": { "kind": "actor", "actor": "elder", "at": "head" },
          "from": 0.12,
          "to": 0.82,
          "data": {
            "name": "El guardián",
            "role": "cuida una campana que no toca",
            "status": "de guardia"
          }
        },
        {
          "id": "H1",
          "type": "hud",
          "placement": { "kind": "screen", "box": { "x": 0.07, "y": 0.085, "w": 0.86, "h": 0.05 } },
          "from": 0.08,
          "to": 0.95,
          "data": { "title": "registro nocturno", "labels": ["plaza", "noche"] }
        }
      ]
    },
    {
      "id": "S02",
      "scene": "doorway",
      "camera": "pushInSlow",
      "seconds": 5.0,
      "transitionIn": 10,
      "line": "El viejo la oía en sueños, todas las noches.",
      "note": "threshold, closer framing: the sound he hears is not there",
      "actors": [
        {
          "id": "elder",
          "preset": "closeup",
          "x": 560,
          "y": 1960,
          "scale": 4.0,
          "facing": 1,
          "hold": "lantern",
          "armR": -22,
          "phase": 1.1
        }
      ],
      "overlays": [
        {
          "id": "C1",
          "type": "callout",
          "placement": { "kind": "screen", "box": { "x": 0.5, "y": 0.595, "w": 0.42, "h": 0.15 } },
          "from": 0.26,
          "to": 0.88,
          "data": {
            "title": "lo que oye",
            "caption": "una campana que nadie más escucha"
          }
        },
        {
          "id": "B1",
          "type": "badge",
          "placement": { "kind": "screen", "box": { "x": 0.07, "y": 0.15, "w": 0.4, "h": 0.05 } },
          "from": 0.12,
          "to": 0.72,
          "data": { "title": "silencio" }
        }
      ]
    },
    {
      "id": "S03",
      "scene": "townNight",
      "camera": "panLeft",
      "seconds": 5.2,
      "transitionIn": 0,
      "line": "El aprendiz contó las veces que faltó.",
      "note": "the data beat: what the apprentice counted, explicitly illustrative",
      "actors": [
        {
          "id": "young",
          "preset": "turn",
          "x": 620,
          "y": 1680,
          "scale": 1.9,
          "facing": -1,
          "hold": "shovel",
          "phase": 0.5
        }
      ],
      "overlays": [
        {
          "id": "G1",
          "type": "bar",
          "placement": { "kind": "screen", "box": { "x": 0.07, "y": 0.55, "w": 0.86, "h": 0.24 } },
          "from": 0.16,
          "to": 0.9,
          "accessible": "the numbers are the apprentice's count, not a measured statistic",
          "illustrative": true,
          "data": {
            "title": "lo que contó el aprendiz",
            "caption": "dibujo esquemático, no una estadística",
            "series": [
              { "label": "oídas por el viejo", "value": 9 },
              { "label": "oídas por el pueblo", "value": 0, "tone": "warn" }
            ]
          }
        },
        {
          "id": "A1",
          "type": "arrow",
          "placement": { "kind": "screen", "box": { "x": 0.55, "y": 0.36, "w": 0.36, "h": 0.12 } },
          "from": 0.3,
          "to": 0.78
        }
      ]
    },
    {
      "id": "S04",
      "scene": "fieldDawn",
      "camera": "dollyOut",
      "seconds": 5.4,
      "transitionIn": 12,
      "line": "Y descubrió que el silencio también se hereda.",
      "note": "resolution: two figures, the panel names the exchange",
      "actors": [
        {
          "id": "elder",
          "preset": "reach",
          "x": 400,
          "y": 1660,
          "scale": 1.7,
          "facing": 1,
          "phase": 0.4
        },
        {
          "id": "young",
          "preset": "idle",
          "x": 760,
          "y": 1700,
          "scale": 1.55,
          "facing": -1,
          "hold": "shovel",
          "phase": 1.3
        }
      ],
      "overlays": [
        {
          "id": "P1",
          "type": "panel",
          "placement": { "kind": "screen", "box": { "x": 0.07, "y": 0.58, "w": 0.86, "h": 0.22 } },
          "from": 0.22,
          "to": 0.92,
          "data": {
            "title": "lo que se hereda",
            "caption": "el oficio pasa de mano en mano",
            "series": [
              { "label": "quien tocaba", "value": "el viejo" },
              { "label": "quien escucha", "value": "el aprendiz" }
            ]
          }
        }
      ]
    }
  ]
}
