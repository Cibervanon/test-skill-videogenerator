{
  "_comment": "UI-direction demo. Each shot declares its narrative intent and a UI proposal; `studio.py ui` decides the presentation mode, the box and the reading window, and can discard what the scene does not need. The renderer draws only the decision.",
  "id": "ui_direccion",
  "title": "El silencio tuvo fecha",
  "logline": "El guardián, el aprendiz y una campana que solo sonó una vez.",
  "fps": 30,
  "style": "cinematic",
  "transitionFrames": 10,
  "library": [
    "rig:default",
    "character:elder",
    "character:young",
    "set:townnight",
    "set:doorway",
    "set:fielddawn",
    "camera:pushinslow",
    "camera:dollyin",
    "camera:tiltup",
    "camera:drift",
    "camera:static",
    "camera:panleft",
    "camera:dollyout",
    "transition:cut",
    "transition:dissolve"
  ],
  "shots": [
    {
      "id": "S01",
      "scene": "townNight",
